{
  "name": "kadhai-desktop",
  "productName": "Kadhai Beta",
  "version": "1.0.0-beta.1",
  "description": "Kadhai as a desktop app: the same local server, in a window of its own.",
  "private": true,
  "main": "main.cjs",
  "author": "Kotini Sai Madhuhas",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "node start.cjs",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.kadhai.desktop",
    "productName": "Kadhai Beta",
    "executableName": "Kadhai",
    "copyright": "Copyright (C) 2026 Kotini Sai Madhuhas",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [
      {
        "from": "..",
        "to": "kadhai",
        "filter": ["server.js", "package.json", "LICENSE", "src/**", "public/**", "bin/**", "skills/**"]
      },
      { "from": "../node_modules", "to": "kadhai/node_modules", "filter": ["**/*"] },
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kadhai-Beta-Setup-${version}.${ext}",
      "shortcutName": "Kadhai Beta",
      "license": "../LICENSE"
    }
  }
}
