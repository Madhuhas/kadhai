# Kadhai configuration. Everything here is optional: API keys are easiest to
# add in the dashboard (the Keys button). Use this file if you prefer one, or
# for the other settings below. Copy it to ".env" to use it.
# Every key below is free - no card required:
#   Gemini   -> https://aistudio.google.com/apikey
#   Groq     -> https://console.groq.com/keys
#   Cerebras -> https://cloud.cerebras.ai
# Give several comma-separated keys to a provider to multiply its free quota.
# Seven more providers work the same way (see the Keys dialog for details):
#   MISTRAL_API_KEYS  OPENROUTER_API_KEYS  NVIDIA_API_KEYS  SAMBANOVA_API_KEYS
#   HUGGINGFACE_API_KEYS  COHERE_API_KEYS  ZAI_API_KEYS
# and each takes a matching ..._MODELS list.

GEMINI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=

# Models, best first. Free line-ups change often: if a model disappears the
# dispatcher disables that route and moves on, but update these when it does.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3.8-27b

# Optional: any other OpenAI-compatible endpoint (OpenRouter free tier, a local
# Ollama at http://localhost:11434/v1, ...). The key may be left empty.
# CUSTOM_BASE_URL=
# CUSTOM_API_KEYS=
# CUSTOM_MODELS=

# Failover order. Routes are interleaved so a 429 hops to the next provider first.
# PROVIDER_ORDER=gemini,groq,cerebras,mistral,openrouter,nvidia,sambanova,huggingface,cohere,zai,custom

# Server
# PORT=4747
# WORKSPACE_DIR=./workspace

# Token / safety budgets
# MAX_SUBTASKS=6
# MAX_REVIEW_ROUNDS=1        (0 switches the Reviewer off)
# MAX_TOOL_ROUNDS=3
# MAX_OUTPUT_TOKENS=4096
# FILE_CONTEXT_CHARS=24000
# REQUEST_TIMEOUT_MS=60000
# MAX_RATE_WAIT_MS=30000

# Code execution: may agents run shell commands in the workspace folder?
#   ask  = each agent command waits for your click in the dashboard (default)
#   auto = agent commands run immediately
#   off  = nothing runs, including your own "!" commands
# EXEC_MODE=ask
# EXEC_TIMEOUT_MS=60000      (a command is killed after this long)
# EXEC_OUTPUT_CHARS=6000     (how much output is sent back to the model)

# Optional isolation: run every command in a throwaway Docker container that
# can see only the workspace folder. Needs Docker Desktop running. If Docker is
# not reachable, commands are refused - they never fall back to your machine.
# EXEC_SANDBOX=docker
# EXEC_DOCKER_IMAGE=node:22-alpine
# EXEC_DOCKER_NETWORK=none   (use "bridge" to let commands reach the internet)

# Offline demo with simulated providers (same as "npm run demo")
# KADHAI_MOCK=1
